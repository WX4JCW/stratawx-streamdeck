{
    "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
    "Name": "WX Deck for StrataWX",
    "Version": "1.0.0.13",
    "Author": "ACMS Digital Systems",
    "Description": "Altimeter, temperature, wind and PIREPs from StrataWx for Microsoft Flight Simulator, on keys.",
    "Category": "WX Deck for StrataWX",
    "CategoryIcon": "imgs/plugin/category",
    "Icon": "imgs/plugin/icon",
    "UUID": "com.acms.stratawx",
    "CodePath": "bin/plugin.js",
    "SDKVersion": 2,
    "Software": {
        "MinimumVersion": "6.5"
    },
    "OS": [
        {
            "Platform": "windows",
            "MinimumVersion": "10"
        }
    ],
    "Nodejs": {
        "Version": "20"
    },
    "Actions": [
        {
            "Name": "Altimeter",
            "UUID": "com.acms.stratawx.altimeter",
            "Icon": "imgs/actions/icon",
            "Tooltip": "Altimeter setting from StrataWx.",
            "Controllers": [
                "Keypad"
            ],
            "UserTitleEnabled": false,
            "SupportedInMultiActions": false,
            "States": [
                {
                    "Image": "imgs/actions/key"
                }
            ]
        },
        {
            "Name": "Temp °C",
            "UUID": "com.acms.stratawx.tempc",
            "Icon": "imgs/actions/icon",
            "Tooltip": "Outside air temperature at the aircraft, in Celsius.",
            "Controllers": [
                "Keypad"
            ],
            "UserTitleEnabled": false,
            "SupportedInMultiActions": false,
            "States": [
                {
                    "Image": "imgs/actions/key"
                }
            ]
        },
        {
            "Name": "Temp °F",
            "UUID": "com.acms.stratawx.tempf",
            "Icon": "imgs/actions/icon",
            "Tooltip": "Outside air temperature at the aircraft, in Fahrenheit.",
            "Controllers": [
                "Keypad"
            ],
            "UserTitleEnabled": false,
            "SupportedInMultiActions": false,
            "States": [
                {
                    "Image": "imgs/actions/key"
                }
            ]
        },
        {
            "Name": "Wind",
            "UUID": "com.acms.stratawx.wind",
            "Icon": "imgs/actions/icon",
            "Tooltip": "Wind at the aircraft's height.",
            "Controllers": [
                "Keypad"
            ],
            "UserTitleEnabled": false,
            "SupportedInMultiActions": false,
            "States": [
                {
                    "Image": "imgs/actions/key"
                }
            ]
        },
        {
            "Name": "Advisories",
            "UUID": "com.acms.stratawx.pireps",
            "Icon": "imgs/actions/icon",
            "Tooltip": "PIREPs and SIGMETs near the weather station, as the StrataWx app lists them. Press to step through them.",
            "Controllers": [
                "Keypad"
            ],
            "UserTitleEnabled": false,
            "SupportedInMultiActions": false,
            "States": [
                {
                    "Image": "imgs/actions/key"
                }
            ]
        },
        {
            "Name": "Conditions",
            "UUID": "com.acms.stratawx.conditions",
            "Icon": "imgs/actions/icon",
            "Tooltip": "Current conditions at the aircraft, with the ceiling or visibility.",
            "Controllers": [
                "Keypad"
            ],
            "UserTitleEnabled": false,
            "SupportedInMultiActions": false,
            "States": [
                {
                    "Image": "imgs/actions/key"
                }
            ]
        },
        {
            "Name": "Freezing Level",
            "UUID": "com.acms.stratawx.freezing",
            "Icon": "imgs/actions/icon",
            "Tooltip": "Where the temperature crosses 0 °C, in feet above sea level.",
            "Controllers": [
                "Keypad"
            ],
            "UserTitleEnabled": false,
            "SupportedInMultiActions": false,
            "States": [
                {
                    "Image": "imgs/actions/key"
                }
            ]
        },
        {
            "Name": "Winds Aloft",
            "UUID": "com.acms.stratawx.windsaloft",
            "Icon": "imgs/actions/icon",
            "Tooltip": "Wind at each level StrataWx sets, on a dial.",
            "Controllers": [
                "Encoder"
            ],
            "UserTitleEnabled": false,
            "SupportedInMultiActions": false,
            "States": [
                {
                    "Image": "imgs/actions/key"
                }
            ],
            "Encoder": {
                "layout": "layouts/strip.json",
                "Icon": "imgs/actions/icon",
                "TriggerDescription": {
                    "Rotate": "Step through the wind levels",
                    "Push": "Back to the surface wind",
                    "Touch": "Back to the surface wind"
                }
            }
        },
        {
            "Name": "Weather",
            "UUID": "com.acms.stratawx.weatherdial",
            "Icon": "imgs/actions/icon",
            "Tooltip": "Everything the WX Deck keys show, on one dial.",
            "Controllers": [
                "Encoder"
            ],
            "UserTitleEnabled": false,
            "SupportedInMultiActions": false,
            "States": [
                {
                    "Image": "imgs/actions/key"
                }
            ],
            "Encoder": {
                "layout": "layouts/strip.json",
                "Icon": "imgs/actions/icon",
                "TriggerDescription": {
                    "Rotate": "Next or previous reading",
                    "Push": "Back to the altimeter",
                    "Touch": "Back to the altimeter"
                }
            }
        }
    ],
    "Profiles": [
        {
            "Name": "profiles/StrataWX-PlusXL",
            "DeviceType": 13,
            "Readonly": false,
            "DontAutoSwitchWhenInstalled": true
        }
    ]
}