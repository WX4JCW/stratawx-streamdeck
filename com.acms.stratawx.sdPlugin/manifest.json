{
    "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
    "Name": "StrataWX",
    "Version": "1.0.0.1",
    "Author": "ACMS Digital Systems",
    "Description": "Altimeter, temperature, wind and PIREPs from StrataWx for Microsoft Flight Simulator, on keys.",
    "Category": "StrataWX",
    "CategoryIcon": "imgs/plugin/category",
    "Icon": "imgs/plugin/icon",
    "UUID": "com.acms.stratawx",
    "CodePath": "bin/plugin.js",
    "SDKVersion": 2,
    "Software": {
        "MinimumVersion": "6.5"
    },
    "OS": [
        {
            "Platform": "windows",
            "MinimumVersion": "10"
        }
    ],
    "Nodejs": {
        "Version": "20"
    },
    "Actions": [
        {
            "Name": "Altimeter",
            "UUID": "com.acms.stratawx.altimeter",
            "Icon": "imgs/actions/icon",
            "Tooltip": "Altimeter setting from StrataWx.",
            "Controllers": [
                "Keypad"
            ],
            "UserTitleEnabled": false,
            "SupportedInMultiActions": false,
            "States": [
                {
                    "Image": "imgs/actions/key"
                }
            ]
        },
        {
            "Name": "Temp °C",
            "UUID": "com.acms.stratawx.tempc",
            "Icon": "imgs/actions/icon",
            "Tooltip": "Outside air temperature at the aircraft, in Celsius.",
            "Controllers": [
                "Keypad"
            ],
            "UserTitleEnabled": false,
            "SupportedInMultiActions": false,
            "States": [
                {
                    "Image": "imgs/actions/key"
                }
            ]
        },
        {
            "Name": "Temp °F",
            "UUID": "com.acms.stratawx.tempf",
            "Icon": "imgs/actions/icon",
            "Tooltip": "Outside air temperature at the aircraft, in Fahrenheit.",
            "Controllers": [
                "Keypad"
            ],
            "UserTitleEnabled": false,
            "SupportedInMultiActions": false,
            "States": [
                {
                    "Image": "imgs/actions/key"
                }
            ]
        },
        {
            "Name": "Wind",
            "UUID": "com.acms.stratawx.wind",
            "Icon": "imgs/actions/icon",
            "Tooltip": "Wind at the aircraft's height.",
            "Controllers": [
                "Keypad"
            ],
            "UserTitleEnabled": false,
            "SupportedInMultiActions": false,
            "States": [
                {
                    "Image": "imgs/actions/key"
                }
            ]
        },
        {
            "Name": "PIREPs",
            "UUID": "com.acms.stratawx.pireps",
            "Icon": "imgs/actions/icon",
            "Tooltip": "Nearby PIREPs. Press to step through them.",
            "Controllers": [
                "Keypad"
            ],
            "UserTitleEnabled": false,
            "SupportedInMultiActions": false,
            "States": [
                {
                    "Image": "imgs/actions/key"
                }
            ]
        }
    ]
}